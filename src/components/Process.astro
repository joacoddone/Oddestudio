---
// Process.astro
// Sección "Cómo trabajamos" con timeline editorial de 5 pasos numerados.
// Cada paso se muestra en una fila con número, título y descripción.

const steps = [
  {
    number: '01',
    title: 'Primer encuentro',
    description: 'Conversamos sobre el proyecto, el sitio y las aspiraciones. Visitamos el terreno cuando es posible. Escuchamos más de lo que hablamos: antes de proponer, entendemos.'
  },
  {
    number: '02',
    title: 'Concepto',
    description: 'Desarrollamos la idea rectora del proyecto: una hipótesis espacial, material y atmosférica que guiará cada decisión posterior. Presentamos primeras propuestas para validar el rumbo.'
  },
  {
    number: '03',
    title: 'Proyecto',
    description: 'Plantas, cortes, vistas, renders. Documentación técnica completa. Selección de materiales, terminaciones y detalles constructivos. Todo lo necesario para construir con precisión.'
  },
  {
    number: '04',
    title: 'Dirección de obra',
    description: 'Acompañamos la construcción con presencia y precisión. Coordinamos equipos, resolvemos imprevistos, controlamos calidad. Cada detalle ejecutado se cuida como si fuera propio.'
  },
  {
    number: '05',
    title: 'Entrega',
    description: 'Recibimos junto al cliente el espacio terminado. Acompañamos el primer tiempo de uso y documentamos el proyecto para su archivo. Un cierre que es también inicio.'
  },
];
---

<section id="process" class="process-section" data-nav-theme="light">
  <div class="process-container">
    
    <!-- Header editorial -->
    <header class="process-header">
      <div class="section-number">04 — Proceso</div>
      <h2 class="section-title">
        Cómo <em>trabajamos</em>
      </h2>
    </header>
    
    <!-- Intro -->
    <div class="process-intro">
      <div></div>
      <p>
        Cinco etapas que estructuran cada proyecto. Un método que respeta los tiempos que la arquitectura necesita.
      </p>
    </div>
    
    <!-- Timeline de pasos -->
    <div class="process-list">
      {steps.map(step => (
        <article class="process-item">
          <div class="process-number">{step.number}</div>
          <div class="process-title">{step.title}</div>
          <div class="process-desc">{step.description}</div>
        </article>
      ))}
    </div>
    
  </div>
</section>

<style>
  .process-section {
    padding: 140px 48px;
    background: #FFFFFF;
  }
  
  .process-container {
    max-width: 1400px;
    margin: 0 auto;
  }
  
  /* Header */
  .process-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 100px;
    gap: 40px;
  }
  
  .section-number {
    font-size: 11px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: #8B8680;
  }
  
  .section-title {
    font-family: var(--font-serif);
    font-size: clamp(40px, 5vw, 72px);
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.02em;
    color: #1A1A1A;
  }
  
  .section-title em {
    font-style: italic;
  }
  
  /* Intro */
  .process-intro {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    margin-bottom: 80px;
    align-items: end;
  }
  
  .process-intro p {
    font-size: 18px;
    line-height: 1.6;
    color: #1A1A1A;
    max-width: 500px;
  }
  
  /* Lista de pasos */
  .process-list {
    border-top: 1px solid #E8E4DE;
  }
  
  .process-item {
    display: grid;
    grid-template-columns: 100px 1fr 2fr;
    gap: 60px;
    padding: 50px 0;
    border-bottom: 1px solid #E8E4DE;
    align-items: start;
    transition: padding 0.4s ease, background 0.4s ease;
  }
  
  .process-item:hover {
    padding-left: 20px;
    padding-right: 20px;
  }
  
  .process-number {
    font-family: var(--font-serif);
    font-size: 20px;
    color: #8B8680;
    font-style: italic;
  }
  
  .process-title {
    font-family: var(--font-serif);
    font-size: clamp(28px, 3vw, 36px);
    font-weight: 300;
    letter-spacing: -0.01em;
    color: #1A1A1A;
  }
  
  .process-desc {
    font-size: 15px;
    line-height: 1.7;
    color: #1A1A1A;
    max-width: 520px;
  }
  
  /* MOBILE */
  @media (max-width: 968px) {
    .process-section {
      padding: 80px 24px;
    }
    
    .process-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
      margin-bottom: 60px;
    }
    
    .process-intro {
      grid-template-columns: 1fr;
      gap: 30px;
      margin-bottom: 60px;
    }
    
    .process-intro p {
      font-size: 15px;
    }
    
    .process-item {
      grid-template-columns: 1fr;
      gap: 14px;
      padding: 36px 0;
    }
    
    .process-item:hover {
      padding-left: 0;
      padding-right: 0;
    }
    
    .process-number {
      font-size: 18px;
    }
    
    .process-title {
      font-size: 26px;
    }
    
    .process-desc {
      font-size: 14px;
    }
  }
</style>