---
// Navigation.astro
// Nav adaptativa con estilo Liquid Glass.
// Cambia su tema (claro/oscuro) según la sección que está debajo
// mediante el atributo data-nav-theme en cada <section>.

const menuItems = [
  { label: 'Obras', href: '#work' },
  { label: 'Reel', href: '#reel' },
  { label: 'Estudio', href: '#studio' },
  { label: 'Proceso', href: '#process' },
  { label: 'Diario', href: '#journal' },
  { label: 'Contacto', href: '#contact' },
];
---

<nav id="mainNav" class="main-nav nav-dark">
  <div class="nav-inner">
    <a href="/" class="logo">Estudio ODD</a>
    
    <ul class="nav-links" id="navLinks">
      {menuItems.map(item => (
        <li>
          <a href={item.href} class="nav-link">{item.label}</a>
        </li>
      ))}
    </ul>
    
    <button id="mobileToggle" class="mobile-toggle" aria-label="Abrir menú">
      ☰
    </button>
  </div>
  
  <div id="mobileMenu" class="mobile-menu hidden">
    <ul>
      {menuItems.map(item => (
        <li>
          <a href={item.href}>{item.label}</a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<script>
  const nav = document.getElementById('mainNav');
  const mobileToggle = document.getElementById('mobileToggle');
  const mobileMenu = document.getElementById('mobileMenu');
  
  // Detecta el tema de la sección debajo del nav y lo aplica
  function updateNavTheme() {
    if (!nav) return;
    
    const checkY = 40;
    const elementBelow = document.elementFromPoint(window.innerWidth / 2, checkY);
    if (!elementBelow) return;
    
    const themedSection = elementBelow.closest('[data-nav-theme]') as HTMLElement | null;
    const theme = themedSection?.dataset.navTheme || 'light';
    
    nav.classList.remove('nav-dark', 'nav-light');
    nav.classList.add(theme === 'dark' ? 'nav-dark' : 'nav-light');
  }
  
  let ticking = false;
  window.addEventListener('scroll', () => {
    if (!ticking) {
      requestAnimationFrame(() => {
        updateNavTheme();
        ticking = false;
      });
      ticking = true;
    }
  });
  updateNavTheme();
  
  // Menú mobile
  if (mobileToggle && mobileMenu) {
    mobileToggle.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
    
    mobileMenu.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
      });
    });
  }
</script>

<style>
  /* Base del nav */
  .main-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 9999;
    mix-blend-mode: normal;
    transition: background 0.5s ease, border-color 0.5s ease;
    isolation: isolate;
    pointer-events: none;
  }
  
  .nav-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 22px 32px;
    transition: padding 0.4s ease;
    max-width: 100%;
    gap: 20px;
    pointer-events: none;
  }
  
  /* LOGO como pastilla de vidrio */
  .logo {
    font-family: var(--font-serif);
    font-size: 18px;
    letter-spacing: 0.05em;
    text-decoration: none;
    transition: color 0.5s ease, background 0.5s ease, box-shadow 0.5s ease;
    flex-shrink: 0;
    padding: 12px 22px;
    border-radius: 100px;
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    position: relative;
    pointer-events: auto;
    display: inline-block;
    line-height: 1;
  }
  
  /* CONTENEDOR DE LINKS - "isla" de vidrio */
    .nav-links {
    display: flex;
    gap: 8px;
    list-style: none;
    padding: 0;
    margin: 0;
    position: relative;
    pointer-events: none;
  }
  
  /* Cada link como una burbuja individual */
    .nav-link {
    text-decoration: none;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-weight: 400;
    transition: color 0.4s ease, background 0.4s ease, transform 0.3s ease, box-shadow 0.5s ease;
    padding: 12px 20px;
    border-radius: 100px;
    display: block;
    position: relative;
    line-height: 1;
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    pointer-events: auto;
  }
  
  .nav-link:hover {
    transform: translateY(-1px);
  }
  
   .main-nav.nav-dark .logo,
  .main-nav.nav-dark .nav-link {
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.22);
    box-shadow: 
      inset 0 1px 0 rgba(255, 255, 255, 0.3),
      inset 0 -1px 0 rgba(0, 0, 0, 0.1),
      0 8px 32px rgba(0, 0, 0, 0.2);
  }
  
  .main-nav.nav-dark .logo {
    color: #FFFFFF;
  }
  
  .main-nav.nav-dark .nav-link {
    color: rgba(255, 255, 255, 0.95);
  }
  
  .main-nav.nav-dark .mobile-toggle {
    color: #FFFFFF;
  }
  
  .main-nav.nav-dark .nav-link:hover {
    background: rgba(255, 255, 255, 0.18);
    color: #FFFFFF;
  }
  
  /* TEMA LIGHT - vidrio sobre fondos claros */
    .main-nav.nav-light .logo,
  .main-nav.nav-light .nav-link {
    background: rgba(255, 255, 255, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.7);
    box-shadow: 
      inset 0 1px 0 rgba(255, 255, 255, 0.9),
      inset 0 -1px 0 rgba(0, 0, 0, 0.04),
      0 8px 32px rgba(26, 26, 26, 0.1);
  }
  
  .main-nav.nav-light .logo {
    color: #1A1A1A;
  }
  
  .main-nav.nav-light .nav-link {
    color: #1A1A1A;
  }
  
  .main-nav.nav-light .mobile-toggle {
    color: #1A1A1A;
  }
  
  .main-nav.nav-light .nav-link:hover {
    background: rgba(26, 26, 26, 0.1);
  }
  
  /* MOBILE */
  .mobile-toggle {
    display: none;
    background: rgba(255, 255, 255, 0.78);
    border: 1px solid rgba(255, 255, 255, 0.22);
    cursor: pointer;
    font-size: 16px;
    padding: 10px 14px;
    border-radius: 100px;
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    transition: color 0.5s ease, background 0.5s ease;
    box-shadow: 
      inset 0 1px 0 rgba(255, 255, 255, 0.3),
      0 8px 32px rgba(0, 0, 0, 0.2);
    pointer-events: auto;
    font-family: inherit;
    line-height: 1;
  }
  
  .main-nav.nav-light .mobile-toggle {
    background: rgba(255, 255, 255, 0.55);
    border-color: rgba(255, 255, 255, 0.7);
    box-shadow: 
      inset 0 1px 0 rgba(255, 255, 255, 0.9),
      0 8px 32px rgba(26, 26, 26, 0.1);
  }
  
  .mobile-menu {
    position: fixed;
    top: 70px;
    left: 16px;
    right: 16px;
    background: rgba(245, 242, 237, 0.85);
    backdrop-filter: blur(30px) saturate(180%);
    -webkit-backdrop-filter: blur(30px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.6);
    border-radius: 24px;
    box-shadow: 
      inset 0 1px 0 rgba(255, 255, 255, 0.8),
      0 20px 50px rgba(26, 26, 26, 0.15);
    pointer-events: auto;
    z-index: 9999;
  }
  
  .mobile-menu ul {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 20px;
    list-style: none;
    margin: 0;
  }
  
  .mobile-menu a {
    color: #1A1A1A;
    text-decoration: none;
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    display: block;
    padding: 14px 18px;
    border-radius: 100px;
    transition: background 0.3s ease;
  }
  
  .mobile-menu a:hover {
    background: rgba(26, 26, 26, 0.06);
  }
  
  .hidden {
    display: none;
  }
  
  @media (max-width: 968px) {
    .nav-inner {
      padding: 16px 16px;
    }
    
    .nav-links {
      display: none;
    }
    
    .mobile-toggle {
      display: block;
    }
    
    .logo {
      font-size: 15px;
      padding: 10px 18px;
    }
  }
</style>