---
// Hero.astro
// Sección de bienvenida del sitio.
// Imagen a pantalla completa con parallax sutil al hacer scroll,
// título dramático en serif y tagline debajo.

interface Props {
  image?: string;
  subtitle?: string;
  title?: string;
  tagline?: string;
}

const {
  image = '/images/projects/casa-typ/cover.jpg',
  subtitle = 'Estudio de Arquitectura — Bella Vista, Corrientes',
  title = 'Espacios que respiran. Arquitectura con <em>intención.</em>',
  tagline = 'Diseñamos residencias, locales comerciales y remodelaciones que priorizan la luz, la materia y la vida que las habita.',
} = Astro.props;
---

<section class="hero">
  <div class="hero-image" id="heroImage" style={`background-image: url('${image}')`}></div>
  
  <div class="hero-content">
    <div class="hero-subtitle">{subtitle}</div>
    <h1 class="hero-title" set:html={title}></h1>
    <p class="hero-tagline">{tagline}</p>
  </div>
  
  <div class="scroll-indicator">
    <span>Descubrir</span>
    <div class="scroll-line"></div>
  </div>
</section>

<script>
  // Parallax suave: la imagen se mueve más lento que el scroll
  const heroImg = document.getElementById('heroImage');
  
  if (heroImg) {
    window.addEventListener('scroll', () => {
      const y = window.scrollY;
      if (y < window.innerHeight) {
        heroImg.style.transform = `translateY(${y * 0.4}px) scale(${1 + y * 0.0003})`;
      }
    });
  }
</script>

<style>
  .hero {
    height: 100vh;
    position: relative;
    overflow: hidden;
    background: #2a2a2a;
  }
  
  .hero-image {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    will-change: transform;
  }
  
  /* Overlay oscuro para que el texto se lea bien */
  .hero-image::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(0,0,0,0.25) 0%,
      rgba(0,0,0,0.1) 50%,
      rgba(0,0,0,0.55) 100%
    );
  }
  
  /* Contenido superpuesto */
  .hero-content {
    position: absolute;
    bottom: 12%;
    left: 48px;
    right: 48px;
    color: #FFFFFF;
    z-index: 2;
    max-width: 1400px;
  }
  
  .hero-subtitle {
    font-size: 11px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    margin-bottom: 24px;
    opacity: 0.85;
  }
  
  .hero-title {
    font-family: var(--font-serif);
    font-size: clamp(48px, 8vw, 120px);
    font-weight: 300;
    line-height: 0.95;
    letter-spacing: -0.02em;
    margin-bottom: 28px;
    color: #FFFFFF;
  }
  
  :global(.hero-title em) {
    font-style: italic;
    font-weight: 300;
  }
  
  .hero-tagline {
    font-size: 15px;
    max-width: 420px;
    opacity: 0.9;
    font-weight: 300;
    line-height: 1.5;
  }
  
  /* Indicador de scroll */
  .scroll-indicator {
    position: absolute;
    bottom: 40px;
    right: 48px;
    color: #FFFFFF;
    font-size: 10px;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    gap: 12px;
    opacity: 0.7;
    z-index: 2;
  }
  
  .scroll-line {
    width: 40px;
    height: 1px;
    background: #FFFFFF;
    animation: scrollLine 2s ease-in-out infinite;
  }
  
  @keyframes scrollLine {
    0%, 100% { transform: scaleX(1); }
    50% { transform: scaleX(0.3); }
  }
  
  /* MOBILE */
  @media (max-width: 968px) {
    .hero-content {
      left: 24px;
      right: 24px;
      bottom: 15%;
    }
    
    .hero-title {
      font-size: clamp(40px, 11vw, 60px);
    }
    
    .hero-subtitle {
      font-size: 10px;
      letter-spacing: 0.32em;
    }
    
    .hero-tagline {
      font-size: 14px;
      max-width: 320px;
    }
    
    .scroll-indicator {
      right: 24px;
      bottom: 24px;
    }
  }
</style>