---
// Contact.astro
// Sección de contacto final del sitio.
// Layout de 2 columnas: info del estudio + formulario.
// Fondo oscuro para cerrar el sitio con impacto editorial.
---

<section id="contact" class="contact-section" data-nav-theme="dark">
  <div class="contact-container">
    
    <!-- Header editorial -->
    <header class="contact-header">
      <div class="section-number">05 — Contacto</div>
      <h2 class="section-title">Conversemos</h2>
    </header>
    
    <!-- Grid: info + formulario -->
    <div class="contact-grid">
      
      <!-- Info del estudio -->
      <div class="contact-info">
        <h3 class="contact-heading">
          Cada proyecto comienza con una <em>conversación.</em>
        </h3>
        
        <div class="contact-block">
          <label>Estudio</label>
          <p>Córdoba 656<br />Bella Vista, Corrientes<br />Argentina</p>
        </div>
        
        <div class="contact-block">
          <label>Correo</label>
          <a href="mailto:estudio@odd.com.ar">estudio@odd.com.ar</a>
        </div>
        
        <div class="contact-block">
          <label>Teléfono</label>
          <a href="tel:+543777312343">+54 3777 312343</a>
        </div>
        
        <div class="contact-block">
          <label>Instagram</label>
          <a href="https://instagram.com/estudiodd" target="_blank" rel="noopener noreferrer">@estudiodd</a>
        </div>
        
        <div class="contact-block">
          <label>Horario</label>
          <p>Lunes a viernes<br />9:00 — 18:00</p>
        </div>
      </div>
      
      <!-- Formulario -->
      <form class="contact-form" id="contactForm">
        <div class="form-field">
          <label for="name">Nombre</label>
          <input type="text" id="name" name="name" required autocomplete="name" />
        </div>
        
        <div class="form-field">
          <label for="email">Correo electrónico</label>
          <input type="email" id="email" name="email" required autocomplete="email" />
        </div>
        
        <div class="form-field">
          <label for="projectType">Tipo de proyecto</label>
          <select id="projectType" name="projectType" required>
            <option value="">Seleccionar</option>
            <option>Vivienda nueva</option>
            <option>Local comercial</option>
            <option>Remodelación / Refacción</option>
            <option>Dirección de obra</option>
            <option>Asesoramiento</option>
            <option>Otro</option>
          </select>
        </div>
        
        <div class="form-field">
          <label for="message">Mensaje</label>
          <textarea id="message" name="message" required placeholder="Contanos sobre tu proyecto..."></textarea>
        </div>
        
        <button type="submit" class="submit-btn">
          Enviar mensaje
        </button>
      </form>
      
    </div>
  </div>
</section>

<script>
  // Manejar envío del formulario
  const form = document.getElementById('contactForm') as HTMLFormElement | null;
  
  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      
      // Por ahora solo muestra un mensaje.
      // Más adelante lo conectamos a un servicio real (Formspree, Web3Forms, etc.)
      alert('Gracias por tu mensaje. Te responderemos a la brevedad.');
      form.reset();
    });
  }
</script>

<style>
  .contact-section {
    padding: 140px 48px;
    background: #1A1A1A;
    color: #FFFFFF;
  }
  
  .contact-container {
    max-width: 1400px;
    margin: 0 auto;
  }
  
  /* Header */
  .contact-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 100px;
    gap: 40px;
  }
  
  .section-number {
    font-size: 11px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: #8B8680;
  }
  
  .section-title {
    font-family: var(--font-serif);
    font-size: clamp(40px, 5vw, 72px);
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.02em;
    color: #FFFFFF;
  }
  
  /* Grid principal */
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 100px;
  }
  
  /* Info izquierda */
  .contact-heading {
    font-family: var(--font-serif);
    font-size: clamp(28px, 3vw, 36px);
    font-weight: 300;
    line-height: 1.2;
    margin-bottom: 40px;
    color: #FFFFFF;
  }
  
  .contact-heading em {
    font-style: italic;
  }
  
  .contact-block {
    margin-bottom: 32px;
  }
  
  .contact-block label {
    font-size: 11px;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: #8B8680;
    display: block;
    margin-bottom: 8px;
  }
  
  .contact-block p,
  .contact-block a {
    font-size: 16px;
    color: #FFFFFF;
    text-decoration: none;
    line-height: 1.5;
    transition: opacity 0.3s;
  }
  
  .contact-block a:hover {
    opacity: 0.7;
  }
  
  /* Formulario */
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  
  .form-field {
    display: flex;
    flex-direction: column;
    position: relative;
  }
  
  .form-field label {
    font-size: 11px;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: #8B8680;
    margin-bottom: 8px;
  }
  
  .form-field input,
  .form-field textarea,
  .form-field select {
    width: 100%;
    background: transparent;
    border: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.3);
    padding: 14px 0;
    color: #FFFFFF;
    font-family: inherit;
    font-size: 15px;
    outline: none;
    transition: border-color 0.3s;
  }
  
  .form-field input:focus,
  .form-field textarea:focus,
  .form-field select:focus {
    border-bottom-color: #FFFFFF;
  }
  
  .form-field textarea {
    resize: vertical;
    min-height: 80px;
    font-family: inherit;
  }
  
  .form-field select {
    cursor: pointer;
  }
  
  .form-field select option {
    background: #1A1A1A;
    color: #FFFFFF;
  }
  
  .form-field input::placeholder,
  .form-field textarea::placeholder {
    color: rgba(255, 255, 255, 0.4);
  }
  
  /* Botón enviar */
  .submit-btn {
    background: none;
    border: 1px solid #FFFFFF;
    color: #FFFFFF;
    padding: 18px 40px;
    font-family: inherit;
    font-size: 12px;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    cursor: pointer;
    align-self: flex-start;
    margin-top: 20px;
    transition: all 0.3s;
    border-radius: 100px;
  }
  
  .submit-btn:hover {
    background: #FFFFFF;
    color: #1A1A1A;
  }
  
  /* MOBILE */
  @media (max-width: 968px) {
    .contact-section {
      padding: 80px 24px;
    }
    
    .contact-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
      margin-bottom: 60px;
    }
    
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 60px;
    }
    
    .contact-heading {
      font-size: 26px;
      margin-bottom: 32px;
    }
    
    .contact-block {
      margin-bottom: 28px;
    }
  }
</style>