---
// WorkGallery.astro
// Sección completa de obras del sitio.
// Lee automáticamente todos los proyectos desde src/content/projects/*.md

import { getCollection } from 'astro:content';
import ProjectCard from './ProjectCard.astro';

const allProjects = await getCollection('projects', ({ data }) => {
  return data.draft !== true;
});

const projects = allProjects.sort((a, b) => a.data.order - b.data.order);

const filters = [
  { id: 'all', label: 'Todos' },
  { id: 'residential', label: 'Residencial' },
  { id: 'commercial', label: 'Comercial' },
  { id: 'renovation', label: 'Remodelación' },
];
---

<section id="work" class="work-section">
  <div class="work-container">
    
    <!-- Header de la sección -->
    <header class="work-header">
      <div class="section-number">01 — Obras</div>
      <h2 class="section-title">
        Proyectos <em>seleccionados</em>
      </h2>
    </header>
    
    <!-- Introducción -->
    <div class="work-intro">
      <div></div>
      <p>
        Cada obra nace de una conversación. Escuchamos el terreno, el cliente, el tiempo. Lo que queda es una síntesis de lo esencial.
      </p>
    </div>
    
    <!-- Filtros -->
    <div class="filters">
      {filters.map(filter => (
        <button 
          class:list={['filter-btn', filter.id === 'all' ? 'active' : '']}
          data-filter={filter.id}
        >
          {filter.label}
        </button>
      ))}
    </div>
    
    <!-- Grid editorial de proyectos -->
    <div class="work-grid">
      {projects.map((project, index) => (
        <div 
          class="project-wrapper reveal"
          data-index={index}
          data-category={project.data.category}
        >
          <ProjectCard 
            slug={project.id}
            title={project.data.title}
            category={project.data.category}
            location={project.data.location.split(',')[0].trim()}
            year={project.data.year}
            cover={project.data.cover}
          />
        </div>
      ))}
    </div>
    
  </div>
</section>

<script>
  // Filtros
  const filterButtons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const projectWrappers = document.querySelectorAll<HTMLElement>('.project-wrapper');
  
  filterButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      filterButtons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      
      const filter = btn.dataset.filter;
      
      projectWrappers.forEach(wrapper => {
        if (filter === 'all' || wrapper.dataset.category === filter) {
          wrapper.classList.remove('hidden-filter');
        } else {
          wrapper.classList.add('hidden-filter');
        }
      });
    });
  });
  
  // Animación de aparición al hacer scroll
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
      }
    });
  }, { threshold: 0.15 });
  
  document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
</script>

<style>
  /* Sección principal */
  .work-section {
    padding: 140px 48px;
    background: #FFFFFF;
  }
  
  .work-container {
    max-width: 1400px;
    margin: 0 auto;
  }
  
  /* Header editorial */
  .work-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 100px;
    gap: 40px;
  }
  
  .section-number {
    font-size: 11px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: #8B8680;
  }
  
  .section-title {
    font-family: var(--font-serif);
    font-size: clamp(40px, 5vw, 72px);
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.02em;
    color: #1A1A1A;
  }
  
  .section-title em {
    font-style: italic;
  }
  
  /* Introducción */
  .work-intro {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    margin-bottom: 80px;
    align-items: end;
  }
  
  .work-intro p {
    font-size: 18px;
    line-height: 1.6;
    color: #1A1A1A;
    max-width: 500px;
  }
  
  /* Filtros */
  .filters {
    display: flex;
    gap: 32px;
    margin-bottom: 80px;
    border-bottom: 1px solid #E8E4DE;
    padding-bottom: 24px;
    overflow-x: auto;
  }
  
  .filters::-webkit-scrollbar { display: none; }
  
  .filter-btn {
    background: none;
    border: none;
    font-family: inherit;
    font-size: 12px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #8B8680;
    cursor: pointer;
    padding: 8px 0;
    transition: color 0.3s;
    position: relative;
    white-space: nowrap;
  }
  
  .filter-btn:hover,
  .filter-btn.active {
    color: #1A1A1A;
  }
  
  .filter-btn.active::after {
    content: '';
    position: absolute;
    bottom: -25px;
    left: 0;
    right: 0;
    height: 1px;
    background: #1A1A1A;
  }
  
  /* Grid editorial asimétrico */
  .work-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 24px;
  }
  
  .project-wrapper {
    opacity: 0;
    transform: translateY(40px);
    transition: opacity 0.9s ease, transform 0.9s ease;
  }
  
  .project-wrapper.visible {
    opacity: 1;
    transform: translateY(0);
  }
  
  .hidden-filter {
    display: none !important;
  }
  
  /* Posiciones asimétricas del grid */
  .project-wrapper:nth-child(1) { grid-column: span 7; }
  .project-wrapper:nth-child(2) { grid-column: span 5; margin-top: 80px; }
  .project-wrapper:nth-child(3) { grid-column: span 5; }
  .project-wrapper:nth-child(4) { grid-column: span 7; margin-top: 60px; }
  .project-wrapper:nth-child(5) { grid-column: span 8; }
  .project-wrapper:nth-child(6) { grid-column: span 4; margin-top: 120px; }
  
  /* Aspect ratio para los "grandes" */
  .project-wrapper:nth-child(1) :global(.project-image),
  .project-wrapper:nth-child(4) :global(.project-image),
  .project-wrapper:nth-child(5) :global(.project-image) {
    aspect-ratio: 16/10 !important;
  }
  
  /* MOBILE */
  @media (max-width: 968px) {
    .work-section {
      padding: 80px 24px;
    }
    
    .work-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
      margin-bottom: 60px;
    }
    
    .work-intro {
      grid-template-columns: 1fr;
      gap: 30px;
      margin-bottom: 60px;
    }
    
    .work-intro p {
      font-size: 15px;
    }
    
    .filters {
      gap: 22px;
      margin-bottom: 60px;
    }
    
    .work-grid {
      grid-template-columns: 1fr;
      gap: 60px;
    }
    
    .project-wrapper:nth-child(n) {
      grid-column: span 1;
      margin-top: 0;
    }
    
    .project-wrapper:nth-child(1) :global(.project-image),
    .project-wrapper:nth-child(4) :global(.project-image),
    .project-wrapper:nth-child(5) :global(.project-image) {
      aspect-ratio: 4/5 !important;
    }
  }
</style>